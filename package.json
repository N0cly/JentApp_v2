{
  "name": "jentapp",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tokens": "node scripts/tokens.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.ts",
    "test": "vitest run",
    "ledger:check": "node --env-file-if-exists=.env scripts/ledger-check.ts",
    "stickers:gc": "node --env-file-if-exists=.env scripts/stickers-gc.ts",
    "admin:grant": "node --env-file-if-exists=.env scripts/admin-grant.ts",
    "announce": "node --env-file-if-exists=.env scripts/announce.ts",
    "release:draft": "node scripts/release-draft.ts",
    "vapid:generate": "node scripts/vapid-generate.ts",
    "test:screens": "vitest run --config scripts/screens/vitest.config.ts"
  },
  "dependencies": {
    "@sentry/nextjs": "11.2.0",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.3",
    "marked": "^18.0.14",
    "next": "16.3.8",
    "nodemailer": "10.0.13",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "web-push": "3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "playwright": "1.63.0",
    "prettier": "^3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
