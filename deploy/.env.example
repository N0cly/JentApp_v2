# Production, sur le VPS : copier en /opt/jentapp/.env, remplir, puis
# `chmod 600 .env`. Ne jamais versionner le fichier rempli. Voir docs/DEPLOY.md.

# Version de l'image, `sha-<commit court>` : écrite par deploy.sh à chaque
# déploiement réussi. Jamais `latest`.
JENTAPP_TAG=

# Nom du projet Compose et port de l'app sur 127.0.0.1. Vides : `jentapp` et 3000,
# les valeurs de la production. La validation les change dans son propre .env.
JENTAPP_PROJECT=
JENTAPP_PORT=

# Base Postgres. Mot de passe neuf, alphanumérique (il entre dans une URL).
POSTGRES_USER=jentapp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jentapp

# URL publique de l'app.
APP_URL=https://jentapp.nocly.fr

# Secret de signature des sessions. Générer : openssl rand -base64 32
BETTER_AUTH_SECRET=

# Emails par Resend, en SMTP : port 587 en STARTTLS, utilisateur `resend`,
# mot de passe = une clé d'API Resend. Domaine nocly.fr vérifié dans Resend.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=
EMAIL_FROM="JentApp <no-reply@nocly.fr>"

# Derrière Nginx : l'adresse IP du client se lit dans X-Forwarded-For.
TRUST_PROXY=true

# Clé de l'API Giphy de production. Vide : GIF désactivés.
GIPHY_API_KEY=

# Push web. Paire neuve, créée par `pnpm vapid:generate`, qui ne doit plus jamais
# changer : la remplacer désabonne tous les téléphones. VAPID_SUBJECT : mailto:<adresse de contact>.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Suivi d'erreurs : DSN du projet « JentApp » dans GlitchTip
# (https://glitchtip.nocly.fr). Vide : suivi désactivé.
ERROR_DSN=
