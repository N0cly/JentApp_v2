# Validation, sur le VPS : copier en /opt/jentapp-validation/.env, remplir, puis
# `chmod 600 .env`. Ses secrets sont les siens, jamais ceux de la production.
# Voir docs/VALIDATION.md et docs/DEPLOY.md.

# Environnement : refresh.sh et les scripts de validation refusent de tourner sans.
APP_ENV=validation

# Comptes gardés intacts par le nettoyage (refresh.sh) : emails séparés par des
# virgules. Tous les autres perdent leur email réel et leur mot de passe.
VALIDATION_KEEP_EMAILS=

# Projet Compose et port de l'app sur 127.0.0.1, à côté de la production (3000).
JENTAPP_PROJECT=jentapp-validation
JENTAPP_PORT=3100

# Version de l'image : écrite par deploy.sh (`develop` par défaut) et refresh.sh.
JENTAPP_TAG=

# Base Postgres de la validation. Mot de passe neuf, alphanumérique.
POSTGRES_USER=jentapp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jentapp

# URL publique de la validation.
APP_URL=https://val.jentapp.nocly.fr

# Secret de signature des sessions, différent de la production.
# Générer : openssl rand -base64 32
BETTER_AUTH_SECRET=

# Emails : forcés vers Mailpit par docker-compose.override.yml, quoi qu'il y ait ici.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="JentApp validation <no-reply@val.jentapp.nocly.fr>"
# Port de l'interface web de Mailpit, sur 127.0.0.1.
MAILPIT_PORT=8025

# Derrière Nginx.
TRUST_PROXY=true

# Délai entre la saisie d'un résultat et le versement, en secondes. 600 par défaut.
SETTLE_DELAY_SECONDS=60

# Clé Giphy. Vide : GIF désactivés.
GIPHY_API_KEY=

# Push web : paire propre à la validation, créée par `pnpm vapid:generate`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Suivi d'erreurs : DSN du projet « JentApp validation » dans GlitchTip, distinct
# de celui de la production.
ERROR_DSN=
