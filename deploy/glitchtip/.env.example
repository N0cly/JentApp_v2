# GlitchTip, sur le VPS : copier en /opt/glitchtip/.env, remplir, puis
# `chmod 600 .env`. Ne jamais versionner le fichier rempli. Voir docs/DEPLOY.md.

# Base de GlitchTip. Mot de passe neuf, alphanumérique (il entre dans une URL).
POSTGRES_PASSWORD=change-me

# Clé secrète de GlitchTip. Générer : openssl rand -hex 32
SECRET_KEY=

# Adresse publique, avec le schéma.
GLITCHTIP_DOMAIN=https://glitchtip.nocly.fr
ALLOWED_HOSTS=glitchtip.nocly.fr

# Emails (alertes, invitations, mot de passe oublié) par Resend, en STARTTLS sur
# le port 587. Mot de passe = une clé d'API Resend dédiée à GlitchTip.
DEFAULT_FROM_EMAIL=glitchtip@nocly.fr
EMAIL_URL=smtp+tls://resend:<clé-api-resend>@smtp.resend.com:587
