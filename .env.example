# Copier en .env et remplir. Ne jamais versionner .env.

# Connexion Postgres de l'app.
# En local, depuis la machine : localhost. Dans le compose, l'hôte est `db`.
DATABASE_URL=postgres://jentapp:change-me@localhost:5432/jentapp

# URL publique de l'app.
APP_URL=http://localhost:3000

# Initialisation du conteneur `db`.
POSTGRES_USER=jentapp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jentapp

# Envoi des emails. En local : Mailpit (http://localhost:8025), sans identifiants.
# Dans le compose, l'app utilise l'hôte `mailpit`.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="JentApp <no-reply@jentapp.local>"
