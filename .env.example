# Copier en .env et remplir. Ne jamais versionner .env.

# Connexion Postgres de l'app.
# En local, depuis la machine : localhost. Dans le compose, l'hôte est `db`.
DATABASE_URL=postgres://jentapp:change-me@localhost:5432/jentapp

# URL publique de l'app.
APP_URL=http://localhost:3000

# Secret de signature des sessions, 32 caractères au moins.
# Générer : openssl rand -base64 32
BETTER_AUTH_SECRET=

# Initialisation du conteneur `db`.
POSTGRES_USER=jentapp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jentapp

# Envoi des emails. En local : Mailpit (http://localhost:8025), sans identifiants.
# Dans le compose, l'app utilise l'hôte `mailpit`.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="JentApp <no-reply@jentapp.local>"

# `true` derrière Nginx : l'adresse IP du client se lit dans X-Forwarded-For.
# Sinon, les limites par adresse IP partagent un seul compteur.
TRUST_PROXY=false

# Dossier des fichiers envoyés (photos de profil). Dans le conteneur : le volume
# `uploads`, monté sur /app/uploads. En local, ./uploads par défaut.
UPLOADS_DIR=

# Délai entre la saisie d'un résultat et le versement des gains, en secondes.
# 600 (10 minutes) par défaut ; plus court en local pour essayer.
SETTLE_DELAY_SECONDS=600

# Clé de l'API Giphy (recherche de GIF, côté serveur seulement). Vide : GIF désactivés.
GIPHY_API_KEY=
